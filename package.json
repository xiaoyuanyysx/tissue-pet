{
  "name": "tissue-pet",
  "version": "3.1.0",
  "description": "卷纸 · 学习桌宠（Tissue）",
  "main": "main/index.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "smoke": "electron . --smoke-test",
    "i18n:check": "node scripts/check-i18n.js"
  },
  "author": "卷纸",
  "license": "MIT",
  "dependencies": {
    "canvas": "^3.2.1",
    "chardet": "^2.1.0",
    "franc-min": "^6.2.0",
    "iconv-lite": "^0.6.3",
    "jszip": "^3.10.1",
    "mammoth": "^1.13.0",
    "pdfjs-dist": "3.11.174"
  },
  "devDependencies": {
    "electron": "^28.3.0",
    "electron-builder": "^24.13.3",
    "node-pre-gyp": "^0.17.0"
  },
  "build": {
    "appId": "com.tissue.deskpet",
    "productName": "tissue-pet",
    "asar": true,
    "files": [
      "main/**",
      "renderer/**",
      "preload.js",
      "preload-editor.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "vocab",
        "to": "vocab",
        "filter": [
          "**/*.txt"
        ]
      },
      {
        "from": "resources",
        "to": "resources"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "tissue-pet"
    }
  }
}
